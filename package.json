{
  "name": "junction",
  "displayName": "%junction.displayName.junction%",
  "description": "%junction.description.junction.local.ai.coding.agent.bridge.for.openclaw.hermes.and.souveraine%",
  "version": "0.1.1",
  "preview": true,
  "publisher": "Plaer1",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.120.0"
  },
  "repository": "https://github.com/Plaer1/junction",
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "chat",
    "coding assistant",
    "local",
    "llm",
    "openclaw",
    "sidebar"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "junction-explorer",
          "title": "%junction.contributes.viewsContainers.secondarySidebar.0.title.junction%",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "junction-explorer": [
        {
          "type": "webview",
          "id": "junction.chatView",
          "name": "%junction.contributes.views.junction-explorer.0.name.junction%",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "junction.configureRuntime",
        "title": "%junction.contributes.commands.0.title.junction.configure.runtime%"
      },
      {
        "command": "junction.openChat",
        "title": "%junction.contributes.commands.1.title.junction.open.sidebar%",
        "icon": "resources/icon.svg"
      },
      {
        "command": "junction.showLogs",
        "title": "%junction.contributes.commands.2.title.junction.show.logs%",
        "icon": "resources/icon.svg"
      },
      {
        "command": "junction.addToThread",
        "title": "%junction.contributes.commands.3.title.add.to.junction.thread%"
      },
      {
        "command": "junction.addFileToThread",
        "title": "%junction.contributes.commands.4.title.add.file.to.junction.thread%"
      }
    ],
    "keybindings": [],
    "menus": {
      "editor/context": [
        {
          "command": "junction.addToThread",
          "when": "resourceScheme == file",
          "group": "junction"
        }
      ],
      "editor/title/context": [
        {
          "command": "junction.addFileToThread",
          "when": "resourceScheme == file",
          "group": "2_junction"
        }
      ],
      "explorer/context": [
        {
          "command": "junction.addFileToThread",
          "when": "resourceScheme == file",
          "group": "junction"
        }
      ]
    },
